global _start
extern kernel_main

section .multiboot
align 4
dd 0x1BADB002
dd 0x00010000
dd -(0x1BADB002 + 0x00010000)
dd 0
dd 0
dd 0
dd 0
dd 0

section .text
_start:
    cli
    mov esp, stack_top
    call kernel_main
    hlt
    jmp $

section .bss
align 16
stack_bottom:
    resb 16384
stack_top:
